{
  "name": "endless-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "verify": "npm run validate && npm run typecheck && npm run lint && npm run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.mts",
    "publish": "tsx scripts/publish.mts",
    "validate:offline": "tsx scripts/validate.mts --offline",
    "test": "vitest run",
    "rebalance": "tsx scripts/rebalance.mts",
    "probe": "tsx scripts/probe.mts",
    "review": "tsx scripts/review.mts",
    "review:serve": "tsx scripts/review.mts --serve"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@convex-dev/auth": "^0.0.95",
    "clsx": "2.1.1",
    "convex": "1.46.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.0.0",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
